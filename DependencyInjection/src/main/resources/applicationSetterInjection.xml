<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    <bean id="myCar" class="com.example.setter.di.Car">
        <property name="specification" ref="carSpecification"/>
    </bean>

    <bean id="carSpecification" class="com.example.setter.di.Specification">
        <property name="make" value="Toyta"/>
        <property name="model" value="2020"/>
    </bean>

</beans>

